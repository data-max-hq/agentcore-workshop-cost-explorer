{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "InvokeSpendAgentHarness",
      "Effect": "Allow",
      "Action": [
        "bedrock-agentcore:InvokeHarness",
        "bedrock-agentcore:InvokeAgentRuntime",
        "bedrock-agentcore:GetHarness"
      ],
      "Resource": "arn:aws:bedrock-agentcore:us-east-1:*:harness/spend_agent-*"
    },
    {
      "Sid": "ReadChatHistory",
      "Effect": "Allow",
      "Action": [
        "bedrock-agentcore:ListSessions",
        "bedrock-agentcore:ListEvents"
      ],
      "Resource": "arn:aws:bedrock-agentcore:us-east-1:*:memory/spend_agent-*"
    }
  ]
}
